# Disable directory listing across the project
Options -Indexes

# Deny access to hidden dotfiles (.env, .env.example, .gitignore, .firebaserc, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Deny access to SQL dumps, logs, Markdown docs, lockfiles, and internal server/config files
<FilesMatch "(?i)^(\.env.*|.*\.sql|.*\.log|.*\.md|.*\.lock|package(-lock)?\.json|composer\.(json|lock)|firebase\.json|firebase-config\.js|firestore\.rules|server\.js|otpService\.js|diff_summary\.txt|.*service-account.*\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
