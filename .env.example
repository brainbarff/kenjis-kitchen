# ==============================================================================
# Kenji's Kitchen Environment Configuration (.env)
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=8787
APP_NAME="Kenji's Kitchen"
# Set APP_URL="" when deployed at root domain (e.g. https://kenjiskitchen.online),
# or /kenjis-kitchen for local XAMPP subfolder testing.
APP_URL=/kenjis-kitchen
# Comma-separated HTTPS origins allowed to make credentialed API requests.
# Include the Firebase Hosting origins and the exact custom storefront/backend origins.
KK_ALLOWED_ORIGINS=https://kenjiskitchen.online

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kenjis_kitchen
DB_USER=root
DB_PASS=

# Realtime WebSocket & Internal Security
# Leave REALTIME_SHARED_SECRET and REALTIME_PUBLIC_URL empty on shared hosting
# (e.g. Hostinger) to use the built-in polling fallback cleanly.
REALTIME_PORT=8787
REALTIME_HOST=127.0.0.1
REALTIME_SHARED_SECRET=
REALTIME_PUBLIC_URL=

# Email delivery through Gmail SMTP or a custom-domain SMTP provider.
# Set MAIL_DELIVERY_MODE=smtp and TEST_ENVIRONMENT=false in production.
# For a custom provider, set SMTP_HOST, SMTP_PORT, and SMTP_SECURE below.
# EMAIL_FROM must be a sender address verified by your email provider/domain.
MAIL_DELIVERY_MODE=smtp
MAIL_DISABLE=false
TEST_ENVIRONMENT=false
EMAIL_SERVICE=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM="Kenji's Kitchen <orders@yourdomain.com>"

# OTP Security Parameters
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Public HTTPS image URL for email branding without an inline attachment.
# Leave blank to use the public Kenji’s Kitchen storefront logo.
EMAIL_LOGO_URL=https://kenjiskitchen.online/assets/img/logo.png
