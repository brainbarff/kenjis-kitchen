# ==============================================================================
# Kenji's Kitchen Environment Configuration (.env)
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=8787
APP_NAME="Kenji's Kitchen"
APP_URL=http://localhost/kenjis-kitchen
# Comma-separated HTTPS origins allowed to make credentialed API requests.
# Include the Firebase Hosting origins and the exact custom storefront/backend origins.
KK_ALLOWED_ORIGINS=https://kenji-s-kitchen-otp.web.app,https://kenji-s-kitchen-otp.firebaseapp.com

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kenjis_kitchen
DB_USER=root
DB_PASS=

# Realtime WebSocket & Internal Security
REALTIME_PORT=8787
REALTIME_HOST=127.0.0.1
REALTIME_SHARED_SECRET=kenjis_kitchen_super_secret_key_32_characters_minimum_len_2026
REALTIME_PUBLIC_URL=ws://127.0.0.1:8787

# Email delivery through Gmail SMTP or a custom-domain SMTP provider.
# For a custom provider, set SMTP_HOST, SMTP_PORT, and SMTP_SECURE below.
# EMAIL_FROM must be a sender address verified by your email provider/domain.
EMAIL_SERVICE=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM="Kenji's Kitchen <orders@yourdomain.com>"

# OTP Security Parameters
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
