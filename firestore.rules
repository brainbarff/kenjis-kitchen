rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /menuItems/{itemId} {
      allow read: if resource.data.active == true || admin();
      allow write: if admin();
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'customer' && request.resource.data.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role;
      allow delete: if admin();
    }
    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || admin());
      allow create: if false; // Checkout uses the trusted placeOrder callable.
      allow update: if admin();
      allow delete: if false;
    }
    match /settings/{settingId} { allow read: if signedIn(); allow write: if admin(); }
  }
}
